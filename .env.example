# Copy to .env and set a unique password before starting.
DB_PASSWORD=
# First deployment only. Set a unique password (12+ characters, max 72 UTF-8 bytes).
# After login, set enabled=false and remove the password, then recreate app.
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=관리자
APP_IMAGE_TAG=local
# Allow direct access at http://SERVER_IP:8080 (requires firewall access).
# For an HTTPS reverse proxy on this host, use 127.0.0.1 instead.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
# Set true when serving through an HTTPS reverse proxy.
COOKIE_SECURE=false
